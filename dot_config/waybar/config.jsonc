// -*- mode: jsonc -*-
{
    // "layer": "top", // Waybar at top layer
    // "position": "bottom", // Waybar position (top|bottom|left|right)
    "height": 30, // Waybar height (to be removed for auto height)
    // "width": 1280, // Waybar width
    "spacing": 4, // Gaps between modules (4px)
    // Choose the order of the modules
    "modules-left": [
        "mango/workspaces",
        "mango/window"
    ],
    "modules-center": [],
    "modules-right": [
        "custom/pysomebar"
    ],
    "mango/workspaces": {
        "max-length": 20
    },
    "mango/window": {
        "align": 0,
        "justify": "left"
    },
    "custom/pysomebar": {
        "format" : "{text}",
        "exec" : "rm /run/user/1000/pysomebar.pid; uv run --directory /home/rob/code/pysomebar/ pysomebar",
    		"tooltip": false
    }
}
